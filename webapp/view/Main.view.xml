                <!-- <VBox fitContainer="true"> -->
                <fb:FilterBar
                    id="fbPreqs"
                    search="onSearch"
                    showRestoreButton="true"
                    showClearButton="true"
                    showClearOnFB="true"
                    clear="onClearFilterBar"
                    class="sapUiSizeCompact"
                >
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            name="P_DateFunction"
                            label="Open on Key Date"
                            groupName="default"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    value="{LocalModel>/P_DateFunction}"
                                    showValueHelp="true"
                                    valueHelpRequest="onOpenKeydate"
                                    valueHelpOnly="true"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- <fb:FilterGroupItem
                            name="Displaycurrency"
                            label="Display Currency"
                            groupName="default"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
