                            label="Company Code"
                            groupName="default"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    value="{LocalModel>/Companycode}"
                                    showValueHelp="true"
                                    valueHelpRequest="onOpenCompanyCode"
                                    valueHelpOnly="true"
                                />
