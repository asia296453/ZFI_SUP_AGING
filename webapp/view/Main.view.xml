                                    valueHelpRequest="onOpenSupplier"
                                    valueHelpOnly="true"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem name="itemtype" label="Item Type" groupName="default" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox  items="{typedtls>/results}"  >
									<core:Item key="{typedtls>key}" text="{typedtls>value}" />
								</MultiComboBox>
							</fb:control>
						</fb:FilterGroupItem>
						
						<fb:FilterGroupItem name="notdue" label="Not Due" groupName="default" visibleInFilterBar="true">
							<fb:control>
								<CheckBox select="onselectcheckbox"></CheckBox>
							</fb:control>
						</fb:FilterGroupItem>

                    </fb:filterGroupItems>
