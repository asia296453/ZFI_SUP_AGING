<mvc:View
    controllerName="zfisupaging.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:custData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:st="sap.ui.comp.smarttable"
>
    <Page
        id="page"
        title="{i18n>title}"
        enableScrolling="true"
    >
        <content>
            <ScrollContainer vertical="true">
                <!-- <VBox fitContainer="true"> -->
                <fb:FilterBar
                    id="fbPreqs"
                    search="onSearch"
                    showRestoreButton="true"
                    showClearButton="true"
                    showClearOnFB="true"
                    clear="onClearFilterBar"
                    class="sapUiSizeCompact"
                >
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            name="P_DateFunction"
                            label="Open on Key Date"
                            groupName="default"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    value="{LocalModel>/P_DateFunction}"
                                    showValueHelp="true"
                                    valueHelpRequest="onOpenKeydate"
                                    valueHelpOnly="true"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            name="Displaycurrency"
                            label="Display Currency"
                            groupName="default"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    value="{LocalModel>/Displaycurrency}"
                                    showValueHelp="true"
                                    valueHelpRequest="onOpenCurrency"
                                    valueHelpOnly="true"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            name="Companycode"
                            label="Company Code"
                            groupName="default"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    value="{LocalModel>/Companycode}"
                                    showValueHelp="true"
                                    valueHelpRequest="onOpenCompanyCode"
                                    valueHelpOnly="true"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            name="Supplier"
                            label="Supplier"
                            groupName="default"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    value="{LocalModel>/Supplier}"
                                    showValueHelp="true"
                                    valueHelpRequest="onOpenSupplier"
                                    valueHelpOnly="true"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>

                <st:SmartTable
                    id="smartTable"
                    header="{i18n>HeaderTitle}"
                    visible="{initialvisible>/flag}"
                    entitySet="AgeingSet"
                    smartFilterId="smartFilterBar"
                    smartVariant="smartVariant"
                    persistencyKey="zfleetadmindash.table"
                    showRowCount="true"
                    beforeRebindTable="onBeforeRebindTable"
                    placeToolbarInTable="true"
                    initiallyVisibleFields="Supplier,Suppliername,NotDue,col0to30,col31to60,col61to90,col91to120,col121to365,col365,Total,TypeLocalForeign,Typeofservicesdesc"
                    ignoreFromPersonalisation="SP,Companycode,,Displaycurrency,P_DateFunction,Typeofservices"
                    requestAtLeastFields=""
                    class="sapUiResponsiveContentPadding"
                    tableType="ResponsiveTable"
                    demandPopin="true"
                    enableAutoColumnWidth="true"
                    useExportToExcel="false"
                >
                    <st:customToolbar>
                        <Toolbar>
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://excel-attachment"
                                press="onExport"
                            />
                        </Toolbar>
                    </st:customToolbar>
                    <Table
                        growing="true"
                        growingThreshold="20"
                        growingScrollToLoad="true"
                        rememberSelections="false"
                        fixedLayout="false"
                        mode="None"
                    >
                        <columns>
                            <Column width="5rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "Supplier", "columnIndex":1, "leadingProperty": "Supplier" , "sortProperty": "Supplier" , "filterProperty": "Supplier"}'
                                    />
                                </customData>
                                <Text text="Supplier" />
                            </Column>

                            <Column width="15rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "Suppliername", "columnIndex":2, "leadingProperty": "Suppliername" , "sortProperty": "Suppliername" , "filterProperty": "Suppliername"}'
                                    />
                                </customData>
                                <Text text="Supplier Name" />
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "NotDue", "columnIndex":3, "leadingProperty": "NotDue" , "sortProperty": "NotDue" , "filterProperty": "NotDue"}'
                                    />
                                </customData>
                                <Text text="Not Due" />
                                <footer>
                                    <Text
                                        id="ftrNotDue"
                                        text="0"
                                    />
                                </footer>
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "col0to30", "columnIndex":4, "leadingProperty": "col0to30" , "sortProperty": "col0to30" , "filterProperty": "col0to30"}'
                                    />
                                </customData>
                                <Text
                                    text="0 - 30"
                                    wrapping="true"
                                />
                                <footer>
                                    <Text
                                        id="ftr_col0to30"
                                        text="0"
                                    />
                                </footer>
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "col31to60", "columnIndex":5, "leadingProperty": "col31to60" , "sortProperty": "col31to60" , "filterProperty": "col31to60"}'
                                    />
                                </customData>
                                <Text text="31 - 60" />
                                <footer>
                                    <Text
                                        id="ftr31_60"
                                        text="0"
                                    />
                                </footer>
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "col61to90", "columnIndex":6, "leadingProperty": "col61to90" , "sortProperty": "col61to90" , "filterProperty": "col61to90"}'
                                    />
                                </customData>
                                <Text text="61 - 90" />
                                <footer>
                                    <Text
                                        id="ftr61_90"
                                        text="0"
                                    />
                                </footer>
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "col91to120", "columnIndex":7, "leadingProperty": "col91to120" , "sortProperty": "col91to120" , "filterProperty": "col91to120"}'
                                    />
                                </customData>
                                <Text
                                    text="91 - 120"
                                    wrapping="true"
                                />
                                <footer>
                                    <Text
                                        id="ftr91_120"
                                        text="0"
                                    />
                                </footer>
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "col121to365", "columnIndex":8, "leadingProperty": "col121to365" , "sortProperty": "col121to365" , "filterProperty": "col121to365"}'
                                    />
                                </customData>
                                <Text text="121 - 365" />
                                <footer>
                                    <Text
                                        id="ftr121_365"
                                        text="0"
                                    />
                                </footer>
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "col365", "columnIndex":9, "leadingProperty": "col365" , "sortProperty": "col365" , "filterProperty": "col365"}'
                                    />
                                </customData>
                                <Text
                                    text=">365"
                                    wrapping="true"
                                />
                                <footer>
                                    <Text
                                        id="ftr365"
                                        text="0"
                                    />
                                </footer>
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "Total", "columnIndex":10, "leadingProperty": "Total" , "sortProperty": "Total" , "filterProperty": "Total"}'
                                    />
                                </customData>
                                <Text
                                    text="Total"
                                    wrapping="true"
                                />
                                <footer>
                                    <Text
                                        id="ftrTotal"
                                        text="0"
                                    />
                                </footer>
                            </Column>

                            <Column width="7rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "TypeLocalForeign", "columnIndex":11, "leadingProperty": "TypeLocalForeign" , "sortProperty": "TypeLocalForeign" , "filterProperty": "TypeLocalForeign"}'
                                    />
                                </customData>
                                <Text
                                    text="Type Local/Foreign"
                                    wrapping="true"
                                />
                            </Column>

                            <Column>
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey": "Typeofservicesdesc", "columnIndex":12, "leadingProperty": "Typeofservicesdesc" , "sortProperty": "Typeofservicesdesc" , "filterProperty": "Typeofservicesdesc"}'
                                    />
                                </customData>
                                <Text
                                    text="Type of services"
                                    wrapping="true"
                                />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <Text text="{path: 'Supplier'}" />
                                <Text text="{path: 'Suppliername'}" />
                                <Text text="{path: 'NotDue'}" />
                                <Text text="{path: 'col0to30'}" />
                                <Text text="{path: 'col31to60'}" />
                                <Text text="{path: 'col61to90'}" />
                                <Text text="{path: 'col91to120'}" />
                                <Text text="{path: 'col121to365'}" />
                                <Text text="{path: 'col365'}" />
                                <Text text="{path: 'Total'}" />
                                <Text text="{path: 'TypeLocalForeign'}" />
                                <Text text="{path: 'Typeofservicesdesc'}" />
                            </ColumnListItem>
                        </items>
                    </Table>
                </st:SmartTable>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>
